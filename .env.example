# Local Saleor 3.22 defaults.
SALEOR_API_URL=http://localhost:8000/graphql/
APP_IFRAME_BASE_URL=http://localhost:3000
APP_API_BASE_URL=http://host.docker.internal:3000

# Saleor app registration storage.
APL=file

# Upstash REST credentials (for public deploys).
UPSTASH_URL=
UPSTASH_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=

# SellAbroad Payment Container credentials.
SELLABROAD_BASE_URL=https://oms-staging.sellabroad.com
SELLABROAD_API_KEY=
SELLABROAD_MERCHANT_ID=
SELLABROAD_SHARED_SECRET=
SELLABROAD_CHECKOUT_BASE_URL=https://app-staging.sellabroad.com
SELLABROAD_WIDGET_URL=https://app-staging.sellabroad.com/api/widget?variant=container

# Channel filter (empty = allow all channels).
SELLABROAD_ENABLED_CHANNELS=
